## Copia este archivo como `.env` y completa los valores.
## No subas credenciales a git.

# Recibe aviso de nuevos pedidos (tu email)
USB_ORDER_NOTIFY_EMAIL=usbshoparg@gmail.com
USB_ADMIN_USERNAME=
USB_ADMIN_PASSWORD=

# Proveedor de envio: `mailgun` o `smtp`
USB_MAIL_PROVIDER=mailgun

# Remitente mostrado al recibir el aviso
USB_MAIL_FROM=Usb-Shop <postmaster@sandboxXXXX.mailgun.org>

# Mailgun (recomendado)
USB_MAILGUN_API_BASE_URL=https://api.mailgun.net
USB_MAILGUN_DOMAIN=sandboxXXXX.mailgun.org
USB_MAILGUN_API_KEY=

# SMTP (opcional, fallback)
USB_SMTP_HOST=
USB_SMTP_PORT=587
USB_SMTP_USER=
USB_SMTP_PASSWORD=
USB_SMTP_FROM=
USB_SMTP_USE_TLS=1
